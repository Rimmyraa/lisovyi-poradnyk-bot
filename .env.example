# --- Обов'язкові ---
# Токен бота від @BotFather
TELEGRAM_BOT_TOKEN=
# Ключ Groq: console.groq.com -> API Keys
GROQ_API_KEY=

# --- Необов'язкові ---
# Моделі Groq у порядку пріоритету (при ліміті чи помилці бот переходить до наступної)
# GROQ_MODELS=llama-3.3-70b-versatile,meta-llama/llama-4-scout-17b-16e-instruct,openai/gpt-oss-120b,qwen/qwen3-32b
# GROQ_FAST_MODELS=llama-3.1-8b-instant,meta-llama/llama-4-scout-17b-16e-instruct,llama-3.3-70b-versatile

# Брати «Лісовий архів» прямо з Google Диска (інакше використовується копія з data/archive).
# Потрібен ключ Google Cloud з увімкненим Google Drive API.
# GDRIVE_FOLDER_ID=1b_hEjnkQfP8ZVP-OEbnYWqoGSFwXMAP3
# GOOGLE_API_KEY=

# Часовий пояс для дат «хто і коли надіслав»
# TZ=Europe/Kyiv
